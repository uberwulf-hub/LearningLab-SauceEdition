<Project Sdk="Microsoft.NET.Sdk">
  <!-- Learning Lab SE for Windows -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LearningLabSE</AssemblyName>
    <RootNamespace>LearningLab.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\LearningLab\Assets\LearningLab.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LearningLab\LearningLab.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the block games (from App Hub's Learning Games: Andrew's own web games) -->
    <None Include="Web/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
