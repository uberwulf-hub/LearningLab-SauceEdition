<Project Sdk="Microsoft.NET.Sdk">
  <!-- The apps' engines: pure .NET, no UI, shared by Windows, Android and the tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LearningLab</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Emulator Lab: LabOS, its demos and lessons, and the processor checks, assembled at start (EmulatorLab\LabSources.cs) -->
    <EmbeddedResource Include="EmulatorLab\os\**\*.s" LogicalName="EmulatorLab/os/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="EmulatorLab\tests\*.s" LogicalName="EmulatorLab/tests/%(Filename)%(Extension)" />
    <!-- Network Lab: the made-up brand of the pretend routers and switches (NetworkLab\Brand.cs) -->
    <EmbeddedResource Include="NetworkLab\brand.json" LogicalName="NetworkLab/brand.json" />
    <!-- Cert Lab and Cyber Range: the courses and the range's challenges, unpacked once into a cache folder (CertLab\CertLabContent.cs) -->
    <EmbeddedResource Include="CertLab\Courses\**\*" LogicalName="CertLab/Courses/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="CertLab\Range\**\*" LogicalName="CertLab/Range/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
